
#compdef cronless cl

_cronless() {
    local -a actions
    actions=(
        'add:Add new task'
        'remove:Remove an existing task'
        'rm:Remove an existing task'
        'list:List all tasks'
        'ls:List all tasks'
        'run:Run a task immediately via task script file'
        'exec:Run a task immediately via task script file'
        'start:Run a task immediately via systemd service for journald logging and update prometheus metrics'
        'logs:Show service logs'
        'enable:Enable the task timer'
        'disable:Disable the task timer'
        'edit:Edit a task file in $EDITOR'
        'debug:Run a task in debug mode'
        'report:Show task status report'
        'update-node-exporter-textfile:Update node_exporter textfile with cronless metrics:file_path'
    )

    if (( CURRENT == 2 )); then
        _describe -t actions 'cronless actions' actions
        return
    fi

    _cronless_args
}

_cronless_args() {
    case $words[2] in
        add)
            return
            ;;
        remove|rm|run|exec|start|logs|enable|disable|edit|debug)
            if (( CURRENT == 3 )); then
                local -a tasks
                tasks=("${(@f)$(cronless list 2>/dev/null | awk '/^ - / {print $2}')}")
                compadd -a tasks
            fi
            ;;
        update-node-exporter-textfile)
            if (( CURRENT == 3 )); then
                _files
            fi
            ;;
    esac
}

compdef _cronless cronless cl