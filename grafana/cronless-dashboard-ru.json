      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - cronless_last_update_timestamp{task=\"_internal\"}",
          "refId": "A",
          "legendFormat": "",
