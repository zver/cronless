#!/bin/bash
set -euo pipefail

usage() {
  echo "Usage:"
  echo "  $0 add <task_name> \"<command>\" \"<OnCalendar>\""
  echo "  $0 remove <task_name>"
  echo "  $0 list"
  echo "  $0 run <task_name>"
  echo "  $0 logs <task_name>"
  echo "  $0 enable <task_name>"
  echo "  $0 disable <task_name>"
  echo "  $0 edit <task_name>"
  echo "  $0 report [options]"
  exit 1
}

prompt_task_name() {
  if ! command -v fzf >/dev/null 2>&1; then
    printf '❌ fzf not found\n' >&2
    printf '   Install fzf to use interactive task selection.\n' >&2
    exit 1
  fi

  [[ -d "$TASKS_DIR" ]] || {
    printf '❌ %s does not exist\n' "$TASKS_DIR" >&2
    exit 1
  }

  local name
  readarray -t names < <(for f in "$TASKS_DIR"/*; do basename "$f"; done 2>/dev/null | sort)
  [[ ${#names[@]} -gt 0 ]] || {
    printf '❌ No tasks configured\n' >&2
    exit 1
  }
  set +e
  name=$(printf '%s\n' "${names[@]}" | fzf --prompt="Select task: ")
  exit_code=$?
  set -e
  if [[ $exit_code -eq 0 && -n "$name" ]]; then
    TASK_NAME="$name"
  else
    printf '❌ Task selection cancelled\n' >&2
    exit 1
  fi
}

is_one_line_bash_script() {
    local file="$1"
    local -a lines

    # файл существует и исполняемый
    [[ -f "$file" && -x "$file" ]] || return 1

    # проверка shebang на bash
    [[ "$(head -n 1 "$file")" =~ ^#!.*/(env[[:space:]]+)?bash ]] || return 1

    # проверка на наличие пустых строк и комментариев
    mapfile -t lines < <(
        sed -E '1{/^#!.*bash/d}; /^[[:space:]]*$/d; /^[[:space:]]*#.*$/d' "$file"
    )

    [[ "${#lines[@]}" -eq 1 ]] || return 1

    printf '%s\n' "${lines[0]}"
}

[[ ! -v USER ]] && USER="$(id -un)"
[[ ! -v HOME ]] && HOME="$(getent passwd "$USER" | cut -d: -f6)"

if [[ $USER == root ]]; then
  SYSTEMCTL="systemctl"
  JOURNALCTL="journalctl"
  UNIT_DIR="/etc/systemd/system"
else
  SYSTEMCTL="systemctl --user"
  JOURNALCTL="journalctl --user"
  UNIT_DIR="$HOME/.config/systemd/user"
  loginctl enable-linger "$USER"
fi
TASKS_DIR="$HOME/.config/systemd/user/cronless-tasks"

ACTION="${1:-}"

# Actions that require a task name as only second arg
TASK_NAME_ACTIONS=( remove logs run enable disable edit )

if [[ $# -ge 2 ]]; then
  TASK_NAME="$2"
elif [[ ${#TASK_NAME_ACTIONS[@]} -gt 0 && " ${TASK_NAME_ACTIONS[*]} " == *" $ACTION "* ]]; then
  if [[ -t 0 ]]; then
    prompt_task_name
    $0 "$ACTION" "$TASK_NAME"
    exit $?
  else
    usage
  fi
fi
[[ -n "${TASK_NAME:-}" ]] && {
  SERVICE_FILE="$UNIT_DIR/cronless-${TASK_NAME}.service"
  TIMER_FILE="$UNIT_DIR/cronless-${TASK_NAME}.timer"
  TASK_FILE="$TASKS_DIR/${TASK_NAME}"
}

[[ -d "$UNIT_DIR" ]] || mkdir -p "$UNIT_DIR"
[[ -d "$TASKS_DIR" ]] || mkdir -p "$TASKS_DIR"

case "$ACTION" in
  add)
    [[ $# -eq 4 ]] || usage

    TASK_COMMAND="$3"
    TASK_SCHEDULE="$4"

    if [ -e "$SERVICE_FILE" ] || [ -e "$TIMER_FILE" ] || [ -e "$TASK_FILE" ]; then
      echo "❌ Task '$TASK_NAME' already exists"
      exit 1
    fi

    # ---------- task config ----------
    cat > "$TASK_FILE" <<EOF
#!/usr/bin/env bash
$TASK_COMMAND
EOF
    chmod +x "$TASK_FILE"

    # ---------- service ----------
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Cronless task $TASK_NAME

[Service]
Type=oneshot
ExecStart=/usr/bin/cronless run $TASK_NAME
EOF

    # ---------- timer ----------
    cat > "$TIMER_FILE" <<EOF
[Unit]
Description=Cronless timer $TASK_NAME

[Timer]
OnCalendar=$TASK_SCHEDULE
Persistent=true

[Install]
WantedBy=timers.target
EOF

    $SYSTEMCTL daemon-reload
    $SYSTEMCTL enable --now "$(basename "$TIMER_FILE")"

    echo "✅ Task '$TASK_NAME' added"
    echo "   Command : $TASK_COMMAND"
    echo "   Schedule: $TASK_SCHEDULE"
    ;;

  remove|rm)
    [[ $# -eq 2 ]] || usage

    $SYSTEMCTL disable --now "cronless-$TASK_NAME.timer" 2>/dev/null || true

    rm -f \
      "$UNIT_DIR/cronless-${TASK_NAME}.service" \
      "$UNIT_DIR/cronless-${TASK_NAME}.timer" \
      "$TASKS_DIR/${TASK_NAME}"

    $SYSTEMCTL daemon-reload
    $SYSTEMCTL reset-failed "cronless-$TASK_NAME.service"

    echo "🗑 Task '$TASK_NAME' removed"
    ;;

  list|ls)
    echo "📋 Configured tasks:"
    shopt -s nullglob
    for TASK_FILE in "$TASKS_DIR"/*; do
      TASK_NAME="${TASK_FILE##*/}"

      CMD="$TASK_FILE"
      if line=$(is_one_line_bash_script "$TASK_FILE"); then
        CMD="$line"
      fi

      TIMER="$UNIT_DIR/cronless-$TASK_NAME.timer"

      if [ -f "$TIMER" ]; then
        SCHEDULE=$(grep '^OnCalendar=' "$TIMER" | cut -d= -f2-)
        STATUS=$($SYSTEMCTL is-active "cronless-$TASK_NAME.timer" 2>/dev/null || true)
      else
        SCHEDULE="—"
        STATUS="missing timer"
      fi

      echo " - $TASK_NAME"
      echo "     command    : $CMD"
      echo "     schedule   : $SCHEDULE"
      echo "     status     : $STATUS"
    done
    ;;

  logs)
    [[ $# -eq 2 ]] || usage
    $JOURNALCTL -u "${SERVICE_FILE##*/}"
    ;;

  run|exec|start)
    [[ $# -eq 2 ]] || usage
    if [ ! -f "$TASK_FILE" ]; then
        echo "Task $TASK_NAME not found!" >&2
        exit 1
    fi
    $TASK_FILE
    EXIT_CODE=$?
    exit $EXIT_CODE
    ;;

  enable|disable)
    [[ $# -eq 2 ]] || usage
    if [ ! -f "$TASK_FILE" ]; then
        echo "Task $TASK_NAME not found!" >&2
        exit 1
    fi
    $SYSTEMCTL "$1" "${TIMER_FILE##*/}"
    EXIT_CODE=$?
    exit $EXIT_CODE
    ;;

  edit)
    [[ $# -eq 2 ]] || usage
    if [ ! -f "$TASK_FILE" ]; then
        echo "Task '$TASK_NAME' not found!" >&2
        exit 1
    fi

    if [[ -v EDITOR && -n "${EDITOR}" ]]; then
        CMD="$EDITOR"
    else
        CMD="editor"
    fi

    exec "$CMD" "$TASK_FILE"
    ;;

  report)
    # Значения по умолчанию
    DAYS=7
    NUM_RUNS=20

    # Обработка аргументов
    while getopts "d:n:" opt; do
      case $opt in
        d) DAYS="$OPTARG" ;;
        n) NUM_RUNS="$OPTARG" ;;
        *) usage ;;
      esac
    done
    shift $((OPTIND - 1))

    # Получаем список активных задач
    shopt -s nullglob
    TASKS=("$TASKS_DIR"/*)
    shopt -u nullglob

    SINCE="$(date -d "$DAYS days ago" '+%Y-%m-%d %H:%M:%S')"

    for TASK_FILE in "${TASKS[@]}"; do
      TASK_NAME="${TASK_FILE##*/}"

      LOGS=$($JOURNALCTL -u "cronless-${TASK_NAME}.service" --since "$SINCE" --no-pager --output=short-unix)

      declare -a START_TIMES=()
      declare -a END_TIMES=()
      declare -a RESULTS=()

      current_start=""

      # Формируем массивы запусков
      while IFS= read -r line; do
        TIME=${line%% *}          # unix timestamp с дробью
        TIME=${TIME%.*}           # округляем до целых секунд

        if [[ "$line" =~ Starting ]]; then
          current_start="$TIME"
        elif [[ "$line" =~ Finished ]]; then
          [[ -n "$current_start" ]] || continue
          START_TIMES+=("$current_start")
          END_TIMES+=("$TIME")
          RESULTS+=("SUCCESS")
          current_start=""
        elif [[ "$line" =~ Failed ]]; then
          [[ -n "$current_start" ]] || continue
          START_TIMES+=("$current_start")
          END_TIMES+=("$TIME")
          RESULTS+=("FAIL")
          current_start=""
        fi
      done <<< "$LOGS"

      TOTAL=${#RESULTS[@]}

      SUCCESS=$(printf '%s\n' "${RESULTS[@]}" | grep -c "SUCCESS" || true)
      FAIL=$((TOTAL - SUCCESS))

      # Последние N запусков
      CHARS=""
      START_INDEX=$(( TOTAL > NUM_RUNS ? TOTAL - NUM_RUNS : 0 ))
      for (( i=START_INDEX; i<TOTAL; i++ )); do
        [[ "${RESULTS[i]}" == "SUCCESS" ]] && CHARS+="✔" || CHARS+="✖"
      done

      # Последний запуск
      if (( ${#END_TIMES[@]} > 0 )); then
        LAST_RUN_UNIX=${END_TIMES[-1]}
        LAST_RUN=$(date -d "@$LAST_RUN_UNIX" '+%Y-%m-%d %H:%M:%S')
        LAST_RESULT=${RESULTS[-1]}

        # Вычисляем длительности всех запусков (в минутах)
        DURATIONS=()
        for i in "${!START_TIMES[@]}"; do
          start=${START_TIMES[i]}
          end=${END_TIMES[i]}
          duration=$(( (end - start) / 60 ))
          DURATIONS+=("$duration")
        done

        MAX_DURATION=$(printf "%s\n" "${DURATIONS[@]}" | sort -nr | head -1)
        LAST_DURATION=${DURATIONS[-1]:-"0"}
        LAST_CHAR=${CHARS: -1}
      else
        LAST_RUN="-"
        LAST_RESULT="-"
        LAST_DURATION="-"
        LAST_CHAR="-"
        MAX_DURATION="-"
      fi

      width=47
      TITLE="$LAST_CHAR $TASK_NAME"
      printf -v pad "%*s" $((width - ${#TITLE})) ""
      pad=${pad// /=}
      printf "%s %s\n" "$TITLE" "$pad"
      echo "  Success runs: $SUCCESS/$TOTAL ($CHARS)"
      echo "  Max duration: ${MAX_DURATION}m"
      echo "  Last run: $LAST_RUN ($LAST_CHAR $LAST_RESULT, ${LAST_DURATION}m)"
      echo ""

      # Очистка массивов перед следующей задачей
      unset START_TIMES END_TIMES RESULTS DURATIONS
    done
    ;;

  *)
    usage
    ;;
esac
