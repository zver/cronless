#!/bin/bash
set -euo pipefail

usage() {
  echo "Usage:"
  echo "  $0 add <task_name> \"<command>\" \"<OnCalendar>\""
  echo "  $0 remove <task_name>"
  echo "  $0 list"
  echo "  $0 run <task_name>"
  echo "  $0 logs <task_name>"
  echo "  $0 enable <task_name>"
  echo "  $0 disable <task_name>"
  echo "  $0 edit <task_name>"
  echo "  $0 report [options]"
  exit 1
}

prompt_task_name() {
  if ! command -v fzf >/dev/null 2>&1; then
    printf '❌ fzf not found\n' >&2
    printf '   Install fzf to use interactive task selection.\n' >&2
    exit 1
  fi

  [[ -d "$TASKS_DIR" ]] || {
    printf '❌ %s does not exist\n' "$TASKS_DIR" >&2
    exit 1
  }

  local name
  readarray -t names < <(for f in "$TASKS_DIR"/*; do basename "$f"; done 2>/dev/null | sort)
  [[ ${#names[@]} -gt 0 ]] || {
    printf '❌ No tasks configured\n' >&2
    exit 1
  }
  set +e
  name=$(printf '%s\n' "${names[@]}" | fzf --prompt="Select task: ")
  exit_code=$?
  set -e
  if [[ $exit_code -eq 0 && -n "$name" ]]; then
    TASK_NAME="$name"
  else
    printf '❌ Task selection cancelled\n' >&2
    exit 1
  fi
}

is_one_line_bash_script() {
    local file="$1"
    local -a lines

    # файл существует и исполняемый
    [[ -f "$file" && -x "$file" ]] || return 1

    # проверка shebang на bash
    [[ "$(head -n 1 "$file")" =~ ^#!.*/(env[[:space:]]+)?bash ]] || return 1

    # проверка на наличие пустых строк и комментариев
    mapfile -t lines < <(
        sed -E '1{/^#!.*bash/d}; /^[[:space:]]*$/d; /^[[:space:]]*#.*$/d' "$file"
    )

    [[ "${#lines[@]}" -eq 1 ]] || return 1

    printf '%s\n' "${lines[0]}"
}

[[ ! -v USER ]] && USER="$(id -un)"
[[ ! -v HOME ]] && HOME="$(getent passwd "$USER" | cut -d: -f6)"

if [[ $USER == root ]]; then
  SYSTEMCTL="systemctl"
  JOURNALCTL="journalctl"
  UNIT_DIR="/etc/systemd/system"
else
  SYSTEMCTL="systemctl --user"
  JOURNALCTL="journalctl --user"
  UNIT_DIR="$HOME/.config/systemd/user"
  loginctl enable-linger "$USER"
fi
TASKS_DIR="$HOME/.config/systemd/user/cronless-tasks"

ACTION="${1:-}"

# Actions that require a task name as only second arg
TASK_NAME_ACTIONS=( remove logs run enable disable edit )

if [[ $# -ge 2 ]]; then
  TASK_NAME="$2"
elif [[ ${#TASK_NAME_ACTIONS[@]} -gt 0 && " ${TASK_NAME_ACTIONS[*]} " == *" $ACTION "* ]]; then
  if [[ -t 0 ]]; then
    prompt_task_name
    $0 "$ACTION" "$TASK_NAME"
    exit $?
  else
    usage
  fi
fi
[[ -n "${TASK_NAME:-}" ]] && {
  SERVICE_FILE="$UNIT_DIR/cronless-${TASK_NAME}.service"
  TIMER_FILE="$UNIT_DIR/cronless-${TASK_NAME}.timer"
  TASK_FILE="$TASKS_DIR/${TASK_NAME}"
}

[[ -d "$UNIT_DIR" ]] || mkdir -p "$UNIT_DIR"
[[ -d "$TASKS_DIR" ]] || mkdir -p "$TASKS_DIR"

case "$ACTION" in
  add)
    [[ $# -eq 4 ]] || usage

    TASK_COMMAND="$3"
    TASK_SCHEDULE="$4"

    if [ -e "$SERVICE_FILE" ] || [ -e "$TIMER_FILE" ] || [ -e "$TASK_FILE" ]; then
      echo "❌ Task '$TASK_NAME' already exists"
      exit 1
    fi

    # ---------- task config ----------
    cat > "$TASK_FILE" <<EOF
#!/usr/bin/env bash
$TASK_COMMAND
EOF
    chmod +x "$TASK_FILE"

    # ---------- service ----------
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Cronless task $TASK_NAME

[Service]
Type=oneshot
ExecStart=/usr/bin/cronless run $TASK_NAME
EOF

    # ---------- timer ----------
    cat > "$TIMER_FILE" <<EOF
[Unit]
Description=Cronless timer $TASK_NAME

[Timer]
OnCalendar=$TASK_SCHEDULE
Persistent=true

[Install]
WantedBy=timers.target
EOF

    $SYSTEMCTL daemon-reload
    $SYSTEMCTL enable --now "$(basename "$TIMER_FILE")"

    echo "✅ Task '$TASK_NAME' added"
    echo "   Command : $TASK_COMMAND"
    echo "   Schedule: $TASK_SCHEDULE"
    ;;

  remove|rm)
    [[ $# -eq 2 ]] || usage

    $SYSTEMCTL disable --now "cronless-$TASK_NAME.timer" 2>/dev/null || true

    rm -f \
      "$UNIT_DIR/cronless-${TASK_NAME}.service" \
      "$UNIT_DIR/cronless-${TASK_NAME}.timer" \
      "$TASKS_DIR/${TASK_NAME}"

    $SYSTEMCTL daemon-reload
    $SYSTEMCTL reset-failed "cronless-$TASK_NAME.service"

    echo "🗑 Task '$TASK_NAME' removed"
    ;;

  list|ls)
    echo "📋 Configured tasks:"
    shopt -s nullglob
    for TASK_FILE in "$TASKS_DIR"/*; do
      TASK_NAME="${TASK_FILE##*/}"

      CMD="$TASK_FILE"
      if line=$(is_one_line_bash_script "$TASK_FILE"); then
        CMD="$line"
      fi

      TIMER="$UNIT_DIR/cronless-$TASK_NAME.timer"

      if [ -f "$TIMER" ]; then
        SCHEDULE=$(grep '^OnCalendar=' "$TIMER" | cut -d= -f2-)
        STATUS=$($SYSTEMCTL is-active "cronless-$TASK_NAME.timer" 2>/dev/null || true)
      else
        SCHEDULE="—"
        STATUS="missing timer"
      fi

      echo " - $TASK_NAME"
      echo "     command    : $CMD"
      echo "     schedule   : $SCHEDULE"
      echo "     status     : $STATUS"
    done
    ;;

  update-node-exporter-textfile)
    [[ $# -eq 2 ]] || usage

    METRICS_FILE="$2"

    # Проверить, существует ли файл
    if [ -e "$METRICS_FILE" ]; then
      # Файл существует — проверить права
      if [ ! -r "$METRICS_FILE" ] || [ ! -w "$METRICS_FILE" ]; then
        echo "❌ Файл '$METRICS_FILE' недоступен для чтения/записи" >&2
        exit 1
      fi
    else
      # Файл не существует — попробовать создать
      # Проверить, существует ли родительская директория
      METRICS_DIR=$(dirname "$METRICS_FILE")
      if [ ! -d "$METRICS_DIR" ]; then
        echo "❌ Директория '$METRICS_DIR' не существует" >&2
        exit 1
      fi

      # Попробовать создать пустой файл
      if ! touch "$METRICS_FILE" 2>/dev/null; then
        echo "❌ Не удалось создать файл '$METRICS_FILE'" >&2
        exit 1
      fi
    fi

    # Очистить файл (оставить только комментарии)
    : > "$METRICS_FILE"

    # Получить список задач
    shopt -s nullglob
    TASKS=("$TASKS_DIR"/*)
    shopt -u nullglob

    if [ ${#TASKS[@]} -eq 0 ]; then
      echo "✅ Нет задач для обновления метрик"
      exit 0
    fi

    # === Сбор данных по каждой задаче ===

    # Массивы для хранения метрик одной метрики по всем задачам (в порядке задач с list)
    declare -a LAST_SUCCESS_ARR=()
    declare -a LAST_EXEC_TIME_ARR=()
    declare -a LAST_START_TS_ARR=()
    declare -a LAST_END_TS_ARR=()
    declare -a ENABLED_ARR=()
    declare -a NAMES_ARR=()

    for TASK_FILE in "${TASKS[@]}"; do
      TASK_NAME="${TASK_FILE##*/}"
      NAMES_ARR+=("$TASK_NAME")

      # Получить статус таймера (enabled/disabled)
      TIMER_FILE="$UNIT_DIR/cronless-$TASK_NAME.timer"
      if [ -f "$TIMER_FILE" ]; then
        IS_ENABLED=$($SYSTEMCTL is-enabled "cronless-$TASK_NAME.timer" 2>/dev/null || echo "unknown")
        if [[ "$IS_ENABLED" == *"enabled"* ]]; then
          ENABLED=1
        else
          ENABLED=0
        fi
      else
        ENABLED=0
      fi

      # Получить данные из journalctl о последнем запуске
      LOGS="$($JOURNALCTL -u "cronless-${TASK_NAME}.service" --since "24 hours ago" --no-pager --output=short-unix 2>&1)"
      # Отфильтровать логи
      LOGS_CLEAN=$(echo "$LOGS" | grep -v '^#' | grep -v '^help' | grep -v '^node_' | grep -v '^cronless_' || true)

      LAST_SUCCESS=0
      LAST_EXEC_TIME=0
      LAST_START_TS="0"
      LAST_END_TS="0"

      # Парсить логи для последнего запуска
      if [[ -n "$LOGS_CLEAN" ]]; then
        L_START_TIMES=()
        L_END_TIMES=()
        L_RESULTS=()

        current_start=""
        while IFS= read -r line; do
          TIME=${line%% *}
          TIME=${TIME%.*}

          if [[ "$line" =~ Starting ]]; then
            current_start="$TIME"
          elif [[ "$line" =~ Finished ]]; then
            [[ -n "$current_start" ]] || continue
            L_START_TIMES+=("$current_start")
            L_END_TIMES+=("$TIME")
            L_RESULTS+=("SUCCESS")
            current_start=""
          elif [[ "$line" =~ Failed ]]; then
            [[ -n "$current_start" ]] || continue
            L_START_TIMES+=("$current_start")
            L_END_TIMES+=("$TIME")
            L_RESULTS+=("FAIL")
            current_start=""
          fi
        done <<< "$LOGS_CLEAN"

        TOTAL=${#L_RESULTS[@]}

        if (( TOTAL > 0 )); then
          if [[ "${L_RESULTS[-1]}" == "FAIL" ]]; then
            LAST_SUCCESS=0
          else
            LAST_SUCCESS=1
          fi
          LAST_START_TS=${L_START_TIMES[-1]}
          LAST_END_TS=${L_END_TIMES[-1]}

          LAST_EXEC_TIME=$(( LAST_END_TS - LAST_START_TS ))
          if (( LAST_EXEC_TIME < 0 )); then
            LAST_EXEC_TIME=0
          fi
        fi

        unset L_START_TIMES L_END_TIMES L_RESULTS
      fi

      LAST_SUCCESS_ARR+=("$LAST_SUCCESS")
      LAST_EXEC_TIME_ARR+=("$LAST_EXEC_TIME")
      LAST_START_TS_ARR+=("$LAST_START_TS")
      LAST_END_TS_ARR+=("$LAST_END_TS")
      ENABLED_ARR+=("$ENABLED")
    done

    NUM_TASKS=${#NAMES_ARR[@]}

    # === Запись файла: HELP/TYPE раз, потом все data-строки ===
    # Метрика 1: cronless_last_success
    echo '# HELP cronless_last_success Last success status of the task (1 = success, 0 = fail)' >> "$METRICS_FILE"
    echo '# TYPE cronless_last_success gauge' >> "$METRICS_FILE"
    for i in $(seq 0 $((NUM_TASKS - 1))); do
      echo "cronless_last_success{task=\"${NAMES_ARR[$i]}\"} ${LAST_SUCCESS_ARR[$i]}" >> "$METRICS_FILE"
    done
    echo '' >> "$METRICS_FILE"

    # Метрика 2: cronless_last_exec_time
    echo '# HELP cronless_last_exec_time Last execution duration in seconds' >> "$METRICS_FILE"
    echo '# TYPE cronless_last_exec_time gauge' >> "$METRICS_FILE"
    for i in $(seq 0 $((NUM_TASKS - 1))); do
      echo "cronless_last_exec_time{task=\"${NAMES_ARR[$i]}\"} ${LAST_EXEC_TIME_ARR[$i]}" >> "$METRICS_FILE"
    done
    echo '' >> "$METRICS_FILE"

    # Метрика 3: cronless_last_start_timestamp
    echo '# HELP cronless_last_start_timestamp Timestamp of last task start' >> "$METRICS_FILE"
    echo '# TYPE cronless_last_start_timestamp gauge' >> "$METRICS_FILE"
    for i in $(seq 0 $((NUM_TASKS - 1))); do
      echo "cronless_last_start_timestamp{task=\"${NAMES_ARR[$i]}\"} ${LAST_START_TS_ARR[$i]}" >> "$METRICS_FILE"
    done
    echo '' >> "$METRICS_FILE"

    # Метрика 4: cronless_last_end_timestamp
    echo '# HELP cronless_last_end_timestamp Timestamp of last task end' >> "$METRICS_FILE"
    echo '# TYPE cronless_last_end_timestamp gauge' >> "$METRICS_FILE"
    for i in $(seq 0 $((NUM_TASKS - 1))); do
      echo "cronless_last_end_timestamp{task=\"${NAMES_ARR[$i]}\"} ${LAST_END_TS_ARR[$i]}" >> "$METRICS_FILE"
    done
    echo '' >> "$METRICS_FILE"

    # Метрика 5: cronless_enabled
    echo '# HELP cronless_enabled Whether the task timer is enabled' >> "$METRICS_FILE"
    echo '# TYPE cronless_enabled gauge' >> "$METRICS_FILE"
    for i in $(seq 0 $((NUM_TASKS - 1))); do
      echo "cronless_enabled{task=\"${NAMES_ARR[$i]}\"} ${ENABLED_ARR[$i]}" >> "$METRICS_FILE"
    done

    # Удалить последнюю пустую строку (она лишняя)
    if [[ -s "$METRICS_FILE" && $(tail -c 1 "$METRICS_FILE") == "" ]]; then
      perl -pi -e 'chomp if eof' "$METRICS_FILE"
    fi

    echo "✅ Метрики обновлены в '$METRICS_FILE'"
    ;;

  logs)
    [[ $# -eq 2 ]] || usage
    $JOURNALCTL -u "${SERVICE_FILE##*/}"
    ;;

  run|exec|start)
    [[ $# -eq 2 ]] || usage
    if [ ! -f "$TASK_FILE" ]; then
        echo "Task $TASK_NAME not found!" >&2
        exit 1
    fi
    $TASK_FILE
    EXIT_CODE=$?
    exit $EXIT_CODE
    ;;

  enable|disable)
    [[ $# -eq 2 ]] || usage
    if [ ! -f "$TASK_FILE" ]; then
        echo "Task $TASK_NAME not found!" >&2
        exit 1
    fi
    $SYSTEMCTL "$1" "${TIMER_FILE##*/}"
    EXIT_CODE=$?
    exit $EXIT_CODE
    ;;

  edit)
    [[ $# -eq 2 ]] || usage
    if [ ! -f "$TASK_FILE" ]; then
        echo "Task '$TASK_NAME' not found!" >&2
        exit 1
    fi

    if [[ -v EDITOR && -n "${EDITOR}" ]]; then
        CMD="$EDITOR"
    else
        CMD="editor"
    fi

    exec "$CMD" "$TASK_FILE"
    ;;

  report)
    # Значения по умолчанию
    DAYS=7
    NUM_RUNS=20

    # Пропустить 'report' — ниже getopts обрабатывает опции
    shift
    while getopts "d:n:" opt; do
      case $opt in
        d) DAYS="$OPTARG" ;;
        n) NUM_RUNS="$OPTARG" ;;
        *) usage ;;
      esac
    done

    # Получаем список активных задач
    shopt -s nullglob
    TASKS=("$TASKS_DIR"/*)
    shopt -u nullglob

    SINCE="$(date -d "$DAYS days ago" '+%Y-%m-%d %H:%M:%S')"

    for TASK_FILE in "${TASKS[@]}"; do
      TASK_NAME="${TASK_FILE##*/}"

      LOGS=$($JOURNALCTL -u "cronless-${TASK_NAME}.service" --since "$SINCE" --no-pager --output=short-unix)

      declare -a START_TIMES=()
      declare -a END_TIMES=()
      declare -a RESULTS=()

      current_start=""

      # Формируем массивы запусков
      while IFS= read -r line; do
        TIME=${line%% *}          # unix timestamp с дробью
        TIME=${TIME%.*}           # округляем до целых секунд

        if [[ "$line" =~ Starting ]]; then
          current_start="$TIME"
        elif [[ "$line" =~ Finished ]]; then
          [[ -n "$current_start" ]] || continue
          START_TIMES+=("$current_start")
          END_TIMES+=("$TIME")
          RESULTS+=("SUCCESS")
          current_start=""
        elif [[ "$line" =~ Failed ]]; then
          [[ -n "$current_start" ]] || continue
          START_TIMES+=("$current_start")
          END_TIMES+=("$TIME")
          RESULTS+=("FAIL")
          current_start=""
        fi
      done <<< "$LOGS"

      TOTAL=${#RESULTS[@]}

      SUCCESS=$(printf '%s\n' "${RESULTS[@]}" | grep -c "SUCCESS" || true)
      FAIL=$((TOTAL - SUCCESS))

      # Последние N запусков
      CHARS=""
      START_INDEX=$(( TOTAL > NUM_RUNS ? TOTAL - NUM_RUNS : 0 ))
      for (( i=START_INDEX; i<TOTAL; i++ )); do
        [[ "${RESULTS[i]}" == "SUCCESS" ]] && CHARS+="✔" || CHARS+="✖"
      done

      # Последний запуск
      if (( ${#END_TIMES[@]} > 0 )); then
        LAST_RUN_UNIX=${END_TIMES[-1]}
        LAST_RUN=$(date -d "@$LAST_RUN_UNIX" '+%Y-%m-%d %H:%M:%S')
        LAST_RESULT=${RESULTS[-1]}

        # Вычисляем длительности всех запусков (в минутах)
        DURATIONS=()
        for i in "${!START_TIMES[@]}"; do
          start=${START_TIMES[i]}
          end=${END_TIMES[i]}
          duration=$(( (end - start) / 60 ))
          DURATIONS+=("$duration")
        done

        MAX_DURATION=$(printf "%s\n" "${DURATIONS[@]}" | sort -nr | head -1)
        LAST_DURATION=${DURATIONS[-1]:-"0"}
        LAST_CHAR=${CHARS: -1}
      else
        LAST_RUN="-"
        LAST_RESULT="-"
        LAST_DURATION="-"
        LAST_CHAR="-"
        MAX_DURATION="-"
      fi

      width=47
      TITLE="$LAST_CHAR $TASK_NAME"
      printf -v pad "%*s" $((width - ${#TITLE})) ""
      pad=${pad// /=}
      printf "%s %s\n" "$TITLE" "$pad"
      echo "  Success runs: $SUCCESS/$TOTAL ($CHARS)"
      echo "  Max duration: ${MAX_DURATION}m"
      echo "  Last run: $LAST_RUN ($LAST_CHAR $LAST_RESULT, ${LAST_DURATION}m)"
      echo ""

      # Очистка массивов перед следующей задачей
      unset START_TIMES END_TIMES RESULTS DURATIONS
    done
    ;;

  *)
    usage
    ;;
esac
