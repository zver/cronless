#compdef cronless

_cronless() {
    local actions
    actions=(
        'add:Add new task'
        'remove,rm:Remove an existing task'
        'list,ls:List all tasks'
        'run,exec,start:Run a task immediately'
        'logs:Show service logs'
        'enable:Enable the task timer'
        'disable:Disable the task timer'
        'edit:Edit a task file in $EDITOR'
        'report:Show task status report'
    )

    local curcontext="$curcontext" state line
    _arguments \
        '1:action:(($actions))'\
        '*::arg:_cronless_args'

}

_cronless_args() {
    case $words[1] in
        add)
            # <task_name> "<command>" "<OnCalendar>"
            (( CURRENT == 2 )) && return
            (( CURRENT == 3 )) && return
            ;;
        remove|rm|run|exec|start|logs|enable|disable|edit)
            (( CURRENT == 2 )) && return 0
            local -a tasks
            local output
            output="$(cronless list 2>/dev/null | awk '/^ - / {print $2}')"
            compadd -- ${(f)output}
            ;;
    esac
}

_cronless "$@"

