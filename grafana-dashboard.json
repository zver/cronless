{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 86400 }
            ]
          },
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "title": "Last metrics update",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "yellow", "value": 15 },
              { "color": "green", "value": 20 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "count(cronless_last_success{task=~\"$task\"})",
          "legendFormat": "Total tasks",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Total tasks",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "cronless_last_exec_time{task=~\"$task\"}",
          "legendFormat": "{{task}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Last execution time (seconds) per task",
      "title": "Last execution time",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "count(cronless_last_success{task=~\"$task\", value=\"1\"})",
          "legendFormat": "Successes",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tasks success count",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "node-graphite",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "FAIL"
                },
                "1": {
                  "color": "green",
                  "text": "SUCCESS"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "id": 1,
      "options": {
        "calculate": false,
        "cellHeight": "sm",
        "footer": {
          "enablePagination": false,
          "enableTotals": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          { "desc": false, "displayName": "cronless_last_start_timestamp{task}" }
        ]
      },
      "title": "Cronless tasks overview",
      "transformations": [
        {
          "id": "organizeFieldsByName",
          "options": {
            "indexByName": {
              "cronless_last_end_timestamp{task}": 4,
              "cronless_last_exec_time{task}": 5,
              "cronless_last_start_timestamp{task}": 3,
              "cronless_last_success{task}": 2,
              "cronless_last_update_timestamp{task}": 6,
              "Time": 0,
              "task": 1
            }
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "cronless_last_start_timestamp\\{task\\}",
            "renamePattern": "last start"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "cronless_last_end_timestamp\\{task\\}",
            "renamePattern": "last end"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "cronless_last_exec_time\\{task\\}",
            "renamePattern": "exec. time (s)"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "cronless_last_success\\{task\\}",
            "renamePattern": "last result"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "cronless_last_update_timestamp\\{task\\}",
            "renamePattern": "updated at"
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 6,
      "options": {
        "axisCenteredZero": false,
        "axisColorMode": "text",
        "axisLabel": "",
        "axisPlacement": "auto",
        "barAlignment": 0,
        "barRadiusTransform": 0,
        "drawStyle": "line",
        "fillOpacity": 15,
        "gradientMode": "scheme",
        "hideFrom": {
          "legend": false,
          "tooltip": false,
          "viz": false
        },
        "lineInterpolation": "smooth",
        "lineWidth": 2,
        "pointSize": 4,
        "scaleDistribution": { "type": "linear" },
        "shadowSize": 0,
        "showPoints": "always",
        "spanNulls": false,
        "stacking": { "group": "A", "mode": "none" },
        "thresholdsStyle": { "mode": "off" }
      },
      "title": "Last execution time (seconds)",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 7,
      "options": {
        "alignValue": "left",
        "colOrder": "Time asc",
        "colWidth": 1,
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "mergeValues": false,
        "rowHeight": 0.9,
        "showHeader": true,
        "showType": "number"
      },
      "title": "Task duration heatmap",
      "type": "heatmap"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "style": "dark",
  "tags": ["cronless", "task-management"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "task",
        "options": [],
        "query": "label_values(cronless_last_success, task)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "promDatasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Cronless",
  "version": 2
}
